
DATABASE_URL=
AI_GATEWAY_API_KEY=
AUTH_SECRET=


AGENT_MODEL=openai/gpt-5-mini
CV_WRITER_MODEL=openai/gpt-5-mini
EXTRACTION_MODEL=openai/gpt-5-nano
JD_ANALYST_MODEL=openai/gpt-4.1-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
# From address for transactional email. Must be on a domain verified in Resend.
EMAIL_FROM="Wellsuited <noreply@younesshassoune.dev>"
# Public origin used to build verification and OAuth callback links.
APP_URL=http://localhost:3000

# --- Billing (Stripe) ---
# Sandbox keys while developing. The app refuses to boot in production with an
# sk_test_ key: a test key live would hand real customers a free paid plan.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/billing/webhook`.
STRIPE_WEBHOOK_SECRET=

# No price ids here on purpose. Each Price is addressed by its lookup key —
# pro_monthly, pro_yearly, max_monthly, max_yearly — set on the Price in the
# Stripe dashboard. A price id differs per account and per mode and changes
# every time a price does, which is four env vars that have to move together;
# a lookup key is one name that is the same everywhere. The amounts come back
# with it, so the pricing page prints what the card will actually be charged.
