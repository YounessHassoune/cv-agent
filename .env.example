
DATABASE_URL=

AI_GATEWAY_API_KEY=

AUTH_SECRET=

# The orchestrator only dispatches tools and follows instructions — it writes
# nothing. Pick for tool-calling discipline, not prose: gemini-2.5-flash was
# double-dispatching cv-writer (two calls, one result, a wasted 36s run).
AGENT_MODEL=openai/gpt-5-mini
# cv-writer and jd-analyst return structured output, so their models must
# support it natively. mistral/mistral-medium does NOT hold CvSchema together
# on a real profile (invalid JSON, ~100% of the time) — it was the cause of
# "the agent could not produce a result matching the requested schema".
CV_WRITER_MODEL=openai/gpt-5-mini
EXTRACTION_MODEL=openai/gpt-5-nano
# Gates the whole pipeline; gpt-5-nano failed it intermittently.
JD_ANALYST_MODEL=openai/gpt-5-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=