generator client {
  provider            = "prisma-client"
  output              = "../agent/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Account record for email+password and Google sign-in. `Profile.userId` and
/// `Application.userId` hold this row's `id`, so deleting a user is deliberate
/// (no cascade) — profiles are removed explicitly by the delete-account route.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  /// Null for Google-only accounts until the user sets a password.
  passwordHash String?
  googleId     String?  @unique
  /// Set the moment the address is proven: the verification link is clicked, or
  /// Google hands back an already-verified email. Null means the account exists
  /// but cannot sign in yet.
  emailVerified DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  verificationTokens VerificationToken[]
}

/// A pending email-verification link. Only the SHA-256 of the token is stored,
/// so a leaked database row cannot be replayed as a sign-in. One live row per
/// user: asking for a new link deletes the previous one, which kills it.
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 hex of the token that travels in the link.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id          String       @id @default(cuid())
  userId      String       @unique
  fullName    String
  headline    String?
  /// Master summary. The agent rewrites a tailored one per application.
  summary     String?
  /// Data URL of the (downscaled) profile photo. Preview only — the compiled
  /// PDF stays photo-free, which is what ATS parsers prefer.
  photoUrl    String?
  /// Default CV layout id (see lib/cv-templates.ts).
  template    String       @default("modern")
  /// Default colour theme id, chosen independently of the layout.
  theme       String       @default("mono")
  contact     Json // { email, phone?, location?, links: string[] }
  languages   Json         @default("[]") // [{ name, level }]
  education   Json         @default("[]") // [{ institution, degree, start?, end? }]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Experience {
  id        String    @id @default(cuid())
  profileId String
  company   String
  role      String
  location  String?
  start     DateTime
  end       DateTime?
  bullets   String[] // raw, truthful bullet points
  stack     String[] // only tech actually used — hallucination guard source
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id          String  @id @default(cuid())
  profileId   String
  title       String
  description String?
  link        String?
  bullets     String[]
  stack       String[]
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String  @id @default(cuid())
  profileId String
  name      String
  category  String? // e.g. "Languages", "Frameworks", "Cloud"
  level     String?
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

/// The result of the most recent CV import, waiting for the editor to collect
/// it. A refresh or a navigation mid-parse kills the POST response, but the
/// parse itself already cost a model call, so it is stored here instead of
/// thrown away. One row per user, deleted the moment the editor applies or
/// discards it — nothing here reaches the profile on its own.
model CvImport {
  userId    String   @id
  filename  String
  /// "running" while the parse is still going, then "done" or "error". The
  /// upload response is not the delivery mechanism — the browser can be gone
  /// long before the parse finishes — so the editor polls this instead.
  status    String   @default("done")
  /// Which step the parse is on ("reading", "parsing", "photo"). The editor
  /// shows it, because a 40s model call behind a bare spinner reads as a hang.
  stage     String   @default("parsing")
  /// What the model has found so far while streaming — `{ name, roles, skills,
  /// education, projects }`. The only honest progress a single long model call
  /// has to offer, and it survives a refresh because it lives here.
  found     Json?
  /// `{}` until the parse finishes.
  profile   Json
  photoUrl  String?
  /// Why the parse failed, shown to the user on their next visit.
  error     String?
  createdAt DateTime @default(now())
}

/// One application per job, regardless of how many languages the CV is
/// tailored into. Per-language work lives in `variants` (JSON, keyed by ISO
/// code) and the binary PDFs in `CvPdf` — JSON can't hold bytes, and base64
/// would bloat every row read.
model Application {
  /// UUIDv7 rather than cuid, because this id is the one that travels: it is in
  /// every `/dashboard/applications/:id` URL and every agent tool call. cuid
  /// embeds a counter and a timestamp in a short string, so ids minted near each
  /// other look near each other — guessable enough to enumerate, even though
  /// every query is scoped by `userId` and a guessed id returns nothing. v7
  /// keeps 74 random bits (not enumerable) while staying time-ordered, so
  /// inserts still land at the right end of the index instead of scattering it.
  ///
  /// Prisma mints this client-side, so the column stays plain TEXT with no
  /// database default, and rows created before this change keep their cuid ids.
  /// Nothing parses the format.
  id          String   @id @default(uuid(7))
  userId      String
  jdText      String
  jdKeywords  Json? // analyze_jd output, reused by score_ats and the review UI
  jdEmbedding Json? // cached JD embedding so loop iterations only re-embed the CV
  /// Target job title from the JD analysis. score_ats matches the CV's own
  /// titles against it — title alignment is a filter every ATS applies.
  jdRole      String?
  jdSeniority String?
  /// Requested target languages (ISO codes), e.g. ["en", "fr"].
  languages   String[] @default(["en"])
  /// Layout this application's PDFs are compiled with.
  template    String   @default("modern")
  /// Colour theme this application's PDFs are compiled with.
  theme       String   @default("mono")
  /// Per-language variants: { [lang]: { cvJson, cvText, atsReport, template, updatedAt } }
  variants    Json?
  /// Persisted eve chat for this application. `chatEvents` is the ordered
  /// stream prefix replayed into `useEveAgent({ initialEvents })`, and
  /// `chatSession` the `{ sessionId, streamIndex }` cursor that continues the
  /// same durable session. Null until the first turn settles.
  chatEvents  Json?
  chatSession Json?
  /// The eve session that created this application, and a fingerprint of the
  /// job ad it was created from. They exist to carry the unique constraint
  /// below: two `analyze_jd` calls dispatched at the same moment both read an
  /// empty table and both created a row, and no application-level check can
  /// close that race — only the database can refuse the second write.
  ///
  /// Nullable, and Postgres treats NULLs as distinct, so rows that predate the
  /// column are exempt rather than in conflict. A *different* job pasted into
  /// the same thread has a different `jdHash`, so it still gets its own row.
  sessionId   String?
  jdHash      String?
  /// The analyst's full role analysis for this job (`ExtractionSchema`).
  /// Reused by every later application with the same `jdHash` so the same job
  /// is always scored against the same must-haves, and read by `write_cv` so
  /// the orchestrator never has to relay it.
  jdExtraction Json?
  /// Per-language CV drafts written by `write_cv` and waiting for
  /// `compile_pdf`: { [lang]: Cv }. A draft is not a variant — no PDF, no
  /// text, no score — so it does not live in `variants`.
  drafts      Json?
  status      Status   @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pdfs        CvPdf[]

  @@unique([userId, sessionId, jdHash])
  @@index([userId, status])
}

/// Compiled PDF bytes for one language variant of one application.
model CvPdf {
  id            String      @id @default(cuid())
  applicationId String
  language      String
  bytes         Bytes
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, language])
}

enum Status {
  DRAFT
  PENDING_REVIEW
  APPROVED
  APPLIED
  REJECTED
}

/// Everything about what this user is allowed to do and what they pay for.
/// One row per user, created lazily on first read — existing accounts need no
/// backfill, they simply resolve to the `free` defaults until a row exists.
///
/// `plan` is written by the Stripe webhook and by nothing else. A checkout
/// `success_url` can be typed by hand, so the redirect is never evidence that
/// money moved.
model Billing {
  userId               String    @id
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// The exact Price object the subscription is on. Stripe prices are
  /// immutable: raising the price means creating a new one, and without this
  /// there is no way to tell a grandfathered subscriber from a new one.
  stripePriceId        String?
  plan                 String    @default("free")
  /// Which revision of the plan's limits this subscriber bought. Cutting an
  /// allowance later must not retroactively shrink what someone already paid
  /// for, so entitlements resolve by (plan, planVersion).
  planVersion          Int       @default(1)
  /// Stripe's subscription status: active | trialing | past_due | canceled.
  status               String?
  /// The paid period the allowance is counted over. Deliberately Stripe's own
  /// period rather than the calendar month — someone who subscribes on the
  /// 28th would otherwise get two allowances in four days.
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Purchased top-up applications, spent only once the period allowance is
  /// gone. Never expires.
  credits              Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// One row per billable action. Quotas count these, not `Application` rows:
/// an application the user deletes still cost a model call, and counting rows
/// would let anyone refill the free tier with the delete button.
model UsageEvent {
  id            String   @id @default(cuid())
  userId        String
  /// "application" | "chat_turn" | "cv_import"
  kind          String
  applicationId String?
  createdAt     DateTime @default(now())

  @@index([userId, kind, createdAt])
}

/// What a model step actually cost. Written by the `usage` hook on every
/// `step.completed`, and by the CV import on finish.
///
/// This is the only honest input to pricing: the per-application estimates in
/// the plan were arithmetic, and arithmetic does not know about retries,
/// reasoning tokens or a user who pastes a forty-page job ad.
model LlmUsage {
  id              String   @id @default(cuid())
  /// Null when the step ran before any tool identified the principal. The eve
  /// hook context carries no auth, so this is stamped from session state that
  /// the first tool call fills in — a turn that never calls a tool has nobody
  /// to bill, and guessing would be worse than leaving it open.
  userId          String?
  /// The eve session the step belongs to. Always known, so it is the fallback
  /// way back to a user: an application records the session that created it.
  sessionId       String?
  applicationId   String?
  /// "application" | "chat" | "import"
  kind            String
  model           String
  inputTokens     Int
  outputTokens    Int
  /// Cached prompt prefix reads, billed at a fraction of the input rate. The
  /// system prompt and tool schemas are identical on every step, so this being
  /// zero means caching is not working and the input bill is several times
  /// what it should be.
  cacheReadTokens Int      @default(0)
  /// What the step cost. The AI Gateway reports this per request and that
  /// figure wins; the local price table only fills in when it does not.
  costUsd         Decimal  @db.Decimal(12, 8)
  /// Whether `costUsd` came from the gateway or from the local price table.
  costSource      String   @default("estimate")
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([applicationId])
}

/// Webhook idempotency. Stripe retries a failed delivery for up to three days,
/// and a retried `checkout.session.completed` must not grant a second month.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}
