generator client {
  provider            = "prisma-client"
  output              = "../agent/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String       @id @default(cuid())
  userId      String       @unique
  fullName    String
  headline    String?
  contact     Json // { email, phone?, location?, links: string[] }
  languages   Json         @default("[]") // [{ name, level }]
  education   Json         @default("[]") // [{ institution, degree, start?, end? }]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Experience {
  id        String    @id @default(cuid())
  profileId String
  company   String
  role      String
  location  String?
  start     DateTime
  end       DateTime?
  bullets   String[] // raw, truthful bullet points
  stack     String[] // only tech actually used — hallucination guard source
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id          String  @id @default(cuid())
  profileId   String
  title       String
  description String?
  link        String?
  bullets     String[]
  stack       String[]
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String  @id @default(cuid())
  profileId String
  name      String
  category  String? // e.g. "Languages", "Frameworks", "Cloud"
  level     String?
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Application {
  id          String   @id @default(cuid())
  userId      String
  jdText      String
  jdKeywords  Json? // analyze_jd output, reused by score_ats and the review UI
  jdEmbedding Json? // cached JD embedding so loop iterations only re-embed the CV
  language    String   @default("en")
  cvJson      Json? // latest tailored CV snapshot (CvSchema)
  cvText      String? // text extracted from the compiled PDF
  atsReport   Json? // { total, breakdown, matched, missing, suggestions }
  pdfBytes    Bytes?
  status      Status   @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

enum Status {
  DRAFT
  PENDING_REVIEW
  APPROVED
  APPLIED
  REJECTED
}
