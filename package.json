{
  "name": "cv-agent",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && node scripts/deploy-migrate.mjs && next build",
    "start": "next start",
    "eve:dev": "eve dev",
    "eve:build": "eve build",
    "typecheck": "tsc",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "verify": "node scripts/verify-pipeline.ts",
    "check:templates": "node scripts/check-templates.ts",
    "stripe:seed": "node --env-file=.env scripts/stripe-seed.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "0.4.3",
    "ai": "^7.0.38",
    "class-variance-authority": "0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "^0.31.3",
    "lucide-react": "1.16.0",
    "mammoth": "^1.12.2",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.3.0-preview.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.27.0",
    "shiki": "4.1.0",
    "streamdown": "2.5.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "unpdf": "^1.8.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "~26.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "19.2.3",
    "husky": "^9.1.7",
    "just-bash": "^3.4.2",
    "lint-staged": "^17.5.1",
    "prisma": "^7.9.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
